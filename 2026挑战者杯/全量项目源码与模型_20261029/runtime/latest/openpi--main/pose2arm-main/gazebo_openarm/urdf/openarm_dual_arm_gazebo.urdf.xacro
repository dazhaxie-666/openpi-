    mass="0.2775092746011571"
    ixx="0.000153588833784759" ixy="-2.94422592188677e-10" ixz="5.21056076779068e-06"
    iyy="0.000113062180225725" iyz="3.75816911469744e-10" izz="8.22999351863579e-05"
    cx="-0.0247184924346635" cy="7.60578399428002e-08" cz="-0.0312643102292087" scale_y="-1" />
