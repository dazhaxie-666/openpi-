    <axis xyz="0 0 -1" />
    <limit lower="-1.5708" upper="1.5708" effort="7" velocity="20.944" />
  </joint>
  <joint name="openarm_left_joint6" type="revolute">
    <origin xyz="0 0 -0.120499999999998" rpy="0 0 0" />
    <parent link="openarm_left_link5" />
    <child link="openarm_left_link6" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.7854" upper="0.7854" effort="7" velocity="20.944" />
  </joint>
  <joint name="openarm_left_joint7" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="openarm_left_link6" />
    <child link="openarm_left_link7" />
    <axis xyz="1 0 0" />
    <limit lower="-0.7854" upper="0.7854" effort="7" velocity="20.944" />
  </joint>

  <joint name="openarm_left_tool0_fixed" type="fixed">
    <parent link="openarm_left_link7" />
    <child link="openarm_left_tool0" />
    <origin xyz="0.0205 0 0" rpy="0 0 0" />
  </joint>

  <xacro:mesh_link name="openarm_right_base_link" source="base_link"
    mass="1.1432284943239561"
    ixx="0.00113607806226198" ixy="3.81487993180929e-07" ixz="1.09161247709715e-08"
    iyy="0.00159935208714031" iyz="2.7521421737084e-08" izz="0.000750541980863571"
