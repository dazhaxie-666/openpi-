<?xml version="1.0"?>
<!--
OpenArm v2.0 dual-arm core for ROS2 + Gazebo Ignition/gz.

The arm joint origins, axes, limits, inertials, and meshes are copied from
/home/ang/openarm_ws/src/openarm_description/assets/robot/openarm_v2.0.
The pinch gripper is intentionally removed; link7 is kept as the real arm tip
frame and a small tool0 marker is fixed at the upstream ee_mount_point.
The torso/head are simplified display geometry; both arms use OpenArm v2.0
single-axis revolute joints.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_dual_arm">
  <xacro:property name="PI" value="3.141592653589793" />
  <xacro:property name="mesh_root" value="file://$(find pose2arm)/gazebo_openarm/meshes/arm" />
  <xacro:property name="body_mesh_root" value="file://$(find pose2arm)/gazebo_openarm/meshes/body" />
  <!-- Official OpenArm v2.0 bimanual body reference points are y=+/-0.031 m. -->
  <xacro:property name="shoulder_span" value="0.062" />
  <xacro:property name="shoulder_half_span" value="${shoulder_span / 2.0}" />

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_link" params="name source mass ixx ixy ixz iyy iyz izz cx cy cz scale_y:=1">
    <link name="${name}">
      <visual name="${name}_visual">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_root}/visual/${source}.dae" scale="1 ${scale_y} 1" />
        </geometry>
        <material name="${name}_material">
          <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
        </material>
      </visual>
      <collision name="${name}_collision">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_root}/collision/${source}.stl" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${cx} ${scale_y * cy} ${cz}" rpy="0 0 0" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="${scale_y * ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${scale_y * iyz}" izz="${izz}" />
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="display_arm_link" params="name length radius mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-length / 2.0}" rpy="0 0 0" />
        <geometry><cylinder radius="${radius}" length="${length}" /></geometry>
        <material name="${color}" />
      </visual>
      <collision>
        <origin xyz="0 0 ${-length / 2.0}" rpy="0 0 0" />
        <geometry><cylinder radius="${radius}" length="${length}" /></geometry>
      </collision>
      <xacro:box_inertial mass="${mass}" x="${2.0 * radius}" y="${2.0 * radius}" z="${length}" />
    </link>
  </xacro:macro>

  <material name="openarm_dark"><color rgba="0.12 0.14 0.16 1.0" /></material>
  <material name="openarm_blue"><color rgba="0.10 0.35 0.80 1.0" /></material>
  <material name="openarm_light"><color rgba="0.82 0.86 0.88 1.0" /></material>
  <material name="openarm_skin"><color rgba="0.72 0.76 0.78 1.0" /></material>
  <material name="openarm_black"><color rgba="0.02 0.02 0.02 1.0" /></material>
  <material name="openarm_front"><color rgba="0.95 0.12 0.08 1.0" /></material>
  <material name="openarm_neon"><color rgba="0.00 0.85 1.00 1.0" /></material>
  <material name="openarm_lime"><color rgba="0.40 1.00 0.20 1.0" /></material>

  <link name="world" />

  <link name="openarm_display_base_link" />

  <joint name="world_to_openarm_display_base" type="fixed">
    <parent link="world" />
    <child link="openarm_display_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="openarm_torso_link" />

  <joint name="display_base_to_torso" type="fixed">
    <parent link="openarm_display_base_link" />
    <child link="openarm_torso_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
  </joint>

  <link name="openarm_shoulder_bar_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0" />
      <geometry><cylinder radius="0.045" length="${shoulder_span}" /></geometry>
      <material name="openarm_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0" />
      <geometry><cylinder radius="0.045" length="${shoulder_span}" /></geometry>
    </collision>
    <xacro:box_inertial mass="1.0" x="0.09" y="${shoulder_span}" z="0.09" />
  </link>

  <joint name="torso_to_shoulder_bar" type="fixed">
    <parent link="openarm_torso_link" />
    <child link="openarm_shoulder_bar_link" />
    <origin xyz="0 0 0.88" rpy="0 0 0" />
  </joint>

  <link name="openarm_head_link">
    <visual name="official_openarm_body_visual">
      <!-- Upstream OpenArm v2.0 has no separate head mesh. This visual uses
           body_link0.dae and aligns its official arm mount height (z=0.698)
           with this demo's shoulder bar (z=0.88 in torso frame). It is visual
           only: no body collision is added, so arm motion remains unobstructed. -->
      <origin xyz="0 0 0.182" rpy="0 0 0" />
      <geometry>
        <mesh filename="${body_mesh_root}/visual/body_link0.dae" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
  </link>

  <joint name="torso_to_head" type="fixed">
    <parent link="openarm_torso_link" />
    <child link="openarm_head_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <xacro:mesh_link name="openarm_left_base_link" source="base_link"
    mass="1.1432284943239561"
    ixx="0.00113607806226198" ixy="3.81487993180929e-07" ixz="1.09161247709715e-08"
    iyy="0.00159935208714031" iyz="2.7521421737084e-08" izz="0.000750541980863571"
    cx="0.00253123748061566" cy="-0.0258185540330169" cz="2.70658291858903e-05" scale_y="-1" />
  <xacro:mesh_link name="openarm_left_link1" source="link1"
    mass="1.1416684646202298"
    ixx="0.0010943212038551" ixy="9.41628673674543e-06" ixz="4.53422182483102e-08"
    iyy="0.000759199728161993" iyz="6.66755698859637e-08" izz="0.000670659201019629"
    cx="0.000900350355624244" cy="-0.0444659716892874" cz="2.88441021165683e-05" scale_y="-1" />
