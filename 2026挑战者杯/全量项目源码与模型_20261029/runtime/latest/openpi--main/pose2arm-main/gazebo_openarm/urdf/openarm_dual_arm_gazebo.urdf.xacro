  </link>

  <joint name="right_arm_mount_joint" type="fixed">
    <parent link="openarm_shoulder_bar_link" />
    <child link="openarm_right_base_link" />
    <origin xyz="0 ${-shoulder_half_span} 0" rpy="0 0 0" />
  </joint>

  <joint name="openarm_right_joint1" type="revolute">
    <origin xyz="0 -0.0625 0" rpy="0 0 0" />
    <parent link="openarm_right_base_link" />
    <child link="openarm_right_link1" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.3963" upper="3.4907" effort="40" velocity="16.755" />
