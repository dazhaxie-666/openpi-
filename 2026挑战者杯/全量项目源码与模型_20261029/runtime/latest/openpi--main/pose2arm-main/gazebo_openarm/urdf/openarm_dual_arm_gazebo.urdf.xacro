  <xacro:mesh_link name="openarm_left_link6" source="link6"
    mass="0.475202773187987"
    ixx="0.000179275941446964" ixy="6.58439346712228e-08" ixz="-3.37101167120887e-08"
    iyy="0.000136247512758587" iyz="3.32253600295544e-08" izz="0.000135340695937386"
    cx="2.27438423593244e-05" cy="0.00068649602098908" cz="5.44000494765995e-05" scale_y="-1" />

  <link name="openarm_left_link7">
    <visual>
      <origin xyz="0.01025 0 0" rpy="0 ${PI / 2.0} 0" />
      <geometry><cylinder radius="0.028" length="0.0205" /></geometry>
      <material name="openarm_blue" />
    </visual>
    <collision>
      <origin xyz="0.01025 0 0" rpy="0 ${PI / 2.0} 0" />
      <geometry><cylinder radius="0.028" length="0.0205" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.0205" y="0.056" z="0.056" />
  </link>

  <link name="openarm_left_tool0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.035" /></geometry>
      <material name="openarm_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.035" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.07" y="0.07" z="0.07" />
  </link>

  <joint name="left_arm_mount_joint" type="fixed">
    <parent link="openarm_shoulder_bar_link" />
    <child link="openarm_left_base_link" />
    <origin xyz="0 ${shoulder_half_span} 0" rpy="0 0 0" />
  </joint>

  <joint name="openarm_left_joint1" type="revolute">
    <origin xyz="0 0.0625 0" rpy="0 0 0" />
    <parent link="openarm_left_base_link" />
    <child link="openarm_left_link1" />
    <axis xyz="0 1 0" />
    <limit lower="-3.4907" upper="1.3963" effort="40" velocity="16.755" />
  </joint>
  <joint name="openarm_left_joint2" type="revolute">
    <origin xyz="0 0.0600000000000001 0" rpy="0 0 0" />
    <parent link="openarm_left_link1" />
    <child link="openarm_left_link2" />
    <axis xyz="-1 0 0" />
    <limit lower="-3.3161" upper="0.17453" effort="40" velocity="16.755" />
  </joint>
  <joint name="openarm_left_joint3" type="revolute">
    <origin xyz="0 0 -0.0662500000000008" rpy="0 0 0" />
    <parent link="openarm_left_link2" />
    <child link="openarm_left_link3" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.5708" upper="1.5708" effort="27" velocity="5.4454" />
  </joint>
  <joint name="openarm_left_joint4" type="revolute">
    <origin xyz="0 0 -0.15375" rpy="0 0 0" />
    <parent link="openarm_left_link3" />
    <child link="openarm_left_link4" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="2.4435" effort="27" velocity="5.4454" />
  </joint>
  <joint name="openarm_left_joint5" type="revolute">
    <origin xyz="0 0 -0.0955000000000005" rpy="0 0 0" />
    <parent link="openarm_left_link4" />
