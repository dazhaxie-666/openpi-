    <visual>
      <origin xyz="0.01025 0 0" rpy="0 ${PI / 2.0} 0" />
      <geometry><cylinder radius="0.028" length="0.0205" /></geometry>
      <material name="openarm_blue" />
    </visual>
    <collision>
      <origin xyz="0.01025 0 0" rpy="0 ${PI / 2.0} 0" />
      <geometry><cylinder radius="0.028" length="0.0205" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.0205" y="0.056" z="0.056" />
  </link>

  <link name="openarm_right_tool0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.035" /></geometry>
      <material name="openarm_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.035" /></geometry>
    </collision>
