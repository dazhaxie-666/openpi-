  <joint name="openarm_right_tool0_fixed" type="fixed">
    <parent link="openarm_right_link7" />
    <child link="openarm_right_tool0" />
    <origin xyz="0.0205 0 0" rpy="0 0 0" />
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="arm_joint_interface" params="name">
      <joint name="${name}">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
    </xacro:macro>
    <xacro:arm_joint_interface name="openarm_right_joint1" />
    <xacro:arm_joint_interface name="openarm_right_joint2" />
    <xacro:arm_joint_interface name="openarm_right_joint3" />
    <xacro:arm_joint_interface name="openarm_right_joint4" />
    <xacro:arm_joint_interface name="openarm_right_joint5" />
    <xacro:arm_joint_interface name="openarm_right_joint6" />
    <xacro:arm_joint_interface name="openarm_right_joint7" />
    <xacro:arm_joint_interface name="openarm_left_joint1" />
    <xacro:arm_joint_interface name="openarm_left_joint2" />
    <xacro:arm_joint_interface name="openarm_left_joint3" />
    <xacro:arm_joint_interface name="openarm_left_joint4" />
    <xacro:arm_joint_interface name="openarm_left_joint5" />
    <xacro:arm_joint_interface name="openarm_left_joint6" />
    <xacro:arm_joint_interface name="openarm_left_joint7" />
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pose2arm)/gazebo_openarm/config/openarm_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
